# Environment files
.env
.env.*
!.env.example

APNS_RELAY_DEPLOYMENT.md

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / frontend
frontend/node_modules/
frontend/dist/

# Root-level too, not just frontend/. Running npm or npx from the repo root
# creates one here, and an unignored copy is worse than clutter: it shadows
# frontend's toolchain, so `npx vitest` from the root silently resolves a
# config-less vitest that runs in the "node" environment and fails every jsdom
# test with "document is not defined". It also sits directly in the path of
# `git add -A`.
/node_modules/

# Go / backend
backend/bin/
backend/.cache/
backend/main
backend/modeleval

# Model-evaluation output. The harness writes one JSON per run holding every
# per-email result; they are large, regenerable, and machine-specific. The
# corpus and tuning documents next to them ARE tracked — only results are not.
backend/cmd/modeleval/results/

# Node / Scripts
scripts/node_modules/

# Local runtime artifacts
kypost/
.kypost-update.lock
share/ollama/models/
*.pid

# Auth and secret artifacts
**/auth.json
**/*_auth.json
**/kypost-auth.json
**/admin.env
**/first-run-password.txt
**/google-services.json
**/GoogleService-Info.plist
**/firebase-service-account*.json
**/service-account*.json

# Claude Code / superpowers session artifacts
.superpowers/
docs/superpowers/

# Understand-Anything analysis workspace (incl. its .trash/ scratch output)
.ua/

# Playwright MCP verification artifacts
.playwright-mcp/

# Agent auto-approval allowlists are per-machine and must not be shared: a
# committed settings.json grants everyone who clones this repo the same standing
# Bash approvals, including wildcards that amount to unrestricted code execution.
# Keep them in settings.local.json, which is gitignored.
.claude/settings.json
