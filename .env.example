OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS_HOST_DIR=./share/ollama/models

# The model that classifies incoming mail. The default is chosen to run on
# modest hardware; if you have RAM to spare, the alternative below is better.
#
# Measured on a 60-email benchmark (backend/cmd/modeleval), five repeats each
# with zero run-to-run variance:
#
#                          unambiguous  keyword   prompt      RAM
#                                 mail    traps  injection  resident
#   nemotron-3-nano:4b            100%      75%      63%    2.9 GB
#   gemma4:e4b                    100%      75%      88%    8.8 GB
#
# Both label ordinary mail equally well. gemma4:e4b resists two more of the
# eight prompt-injection probes — emails that try to talk the classifier into
# filing them somewhere they do not belong — but needs three times the memory.
# A wrong label is the worst case either way: the allowlist means a hostile
# email can at most choose which of your four folders it lands in.
#
# Speed is deliberately not listed: it tracks your CPU and host load far more
# than the model. The two are within ~20% of each other, and the poller paces
# itself at one message every three seconds regardless.
#
# Pick nemotron-3-nano:4b (the default) unless the host has 12 GB or more free.
OLLAMA_MODEL=nemotron-3-nano:4b

# Classifier admission control.
#
# CLASSIFY_CONCURRENCY bounds how many classifications run at once. The default
# of 1 matches Ollama's default of one generation at a time; if you have raised
# OLLAMA_NUM_PARALLEL, raise this to match or the extra capacity is unused.
#
# CLASSIFY_PACE_MS inserts idle time between the starts of consecutive
# classify requests. Default 0. Set it only for a backend that misbehaves under
# back-to-back requests — every millisecond here is throughput the whole
# instance loses, shared across all users.
#CLASSIFY_CONCURRENCY=1
#CLASSIFY_PACE_MS=0
#OLLAMA_MODEL=gemma4:e4b

# Optional overrides
TUNING_FILE=/kypost/config/TUNING.md
TZ=America/New_York
# Public server URL used in the mobile pairing QR payload (for example https://my-domain.example)
SERVER_BASE_URL=
# HMAC secret for pickup links, PGP QR key exchange, and mobile pairing tokens.
#
# Leave this EMPTY unless you run more than one replica. When unset, the server
# generates a 32-byte secret on first start and persists it at
# PAIRING_SECRET_FILE (default /kypost/private/pairing.key), the same way it
# already handles the IMAP, TOTP, PGP and pickup keys.
#
# Set it only when several replicas must agree on one secret, since each
# container would otherwise generate its own. Use real entropy if you do:
#   openssl rand -base64 32
PAIRING_SECRET=
#PAIRING_SECRET_FILE=/kypost/private/pairing.key   # default: $SECRET_DIR/pairing.key

# Which peers' X-Forwarded-Proto/Host/For headers the server will believe, as a
# comma-separated list of CIDRs or bare IPs. Empty (the default) trusts nothing
# and uses the connection's own address for every decision that depends on it:
# the cookie Secure flag, pairing URLs, and the login/CardDAV/device lockout and
# rate-limit keys.
#
# Set this to your reverse proxy's address SPECIFICALLY. Any peer inside the
# range you name can forge its own client IP, and thereby bypass every rate
# limit and lockout keyed on it.
#
#   TRUSTED_PROXY_CIDRS=127.0.0.1/32        # nginx or cloudflared on the same host
#   TRUSTED_PROXY_CIDRS=172.17.0.4          # proxy container on the default bridge
#
# For the second form, get the address from the proxy container itself:
#   docker inspect -f '{{.NetworkSettings.Networks.bridge.IPAddress}}' <proxy>
# Docker assigns it, so re-check it after recreating that container.
#
# Name the container's OWN address, not the bridge gateway (172.17.0.1) and not
# the whole subnet. The gateway is what a proxy on some OTHER Docker network is
# source-NATed to on the way in, which is the same address for every caller —
# trusting it lets anything that reaches the port name its own client IP, and
# leaving it untrusted keys every user into one shared lockout bucket. The fix is
# to move the proxy onto the same bridge as KyPost (the compose file puts KyPost
# on Docker's default bridge for exactly this reason) so that there is a real
# per-proxy address to name here.
#
# SETTING THIS RAISES THE STAKES ON KYPOST_BIND (below). Trusting a proxy's
# headers is only sound if the proxy is the ONLY way in. If 5866 is also
# reachable directly — a wide publish with no host firewall — then a caller who
# skips the proxy still cannot forge an IP (the peer address is checked), but any
# host inside the range you name above can. Narrow both, or verify with
# GET /api/status that clientIp is the real visitor.
#
# From a trusted peer the client address is read from CF-Connecting-IP when
# present (Cloudflare sets it to exactly the visitor address, with no hop list to
# parse), otherwise from the RIGHT-most X-Forwarded-For element. That order
# matters behind Cloudflare Tunnel: the edge appends the visitor IP to XFF, but
# cloudflared can append its own hop after it, and the right-most element would
# then be a loopback address for every visitor — collapsing the per-IP lockout
# into one shared bucket where 50 failures from anyone locks out everyone.
#
# VERIFY IT, do not assume. Sign in and fetch GET /api/status: `clientIp` should
# be your own public address and `proxyHeadersTrusted` should be true. If
# clientIp is 127.0.0.1 or a 172.x bridge address, every user shares one lockout
# key and the session cookie is not being marked Secure.
#
# This REPLACES the old TRUST_PROXY_HEADERS=true, which is no longer read.
# Setting it did not identify a proxy — it trusted forwarded headers on every
# connection from any peer, so it only behaved correctly when nothing but the
# proxy could reach the port.
#TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Interface the compose file publishes port 5866 on. Defaults to 0.0.0.0.
#
# NARROW THIS IF YOU CAN. With no TLS configured this server speaks plain HTTP,
# so an unproxied 5866 on a LAN is cleartext — and if TRUSTED_PROXY_CIDRS is set,
# anything able to reach 5866 directly can forge X-Forwarded-For and defeat every
# IP-keyed lockout by skipping the proxy.
#
#   KYPOST_BIND=127.0.0.1     # proxy on this host, reaching 127.0.0.1:5866
#   KYPOST_BIND=192.168.1.5   # only the interface the proxy talks to
#
# CHECK YOUR PROXY FIRST. Loopback-only publishing severs any proxy that reaches
# this container by the host's LAN address — a cloudflared or nginx on another
# machine, or a container using host.docker.internal. It briefly WAS the default
# and took exactly that setup offline, which is why it is opt-in now. If your
# proxy runs on this host and targets 127.0.0.1:5866, loopback is safe and
# better.
#
# Best of all: put the proxy on the same Docker network and address the container
# by name. Container-to-container traffic ignores published ports, so nothing
# needs publishing.
#KYPOST_BIND=127.0.0.1

# Optional inbound TLS: serve HTTPS directly instead of plain HTTP.
#
# Set BOTH or NEITHER. Setting only one is a startup error, not a fallback — an
# operator who supplied a certificate believes the port is encrypted, and quietly
# serving cleartext on it is the worse outcome.
#
# WHAT THIS BUYS. Everything that asks "did this arrive over TLS?" is answered by
# the connection itself instead of by a header: the session cookie gets Secure,
# HSTS is sent, and the login proof-of-work's secure-context requirement is
# satisfied. TRUSTED_PROXY_CIDRS becomes irrelevant, because no forwarded header
# has to be believed. This is the only configuration where the answer does not
# depend on trusting something upstream.
#
# WHEN YOU DO NOT NEED IT. Behind cloudflared or an nginx on the same host, the
# hop to this server is loopback — there is no network on it to protect, and TLS
# there buys nothing. It matters for direct exposure, and for a proxy on a
# DIFFERENT host, where that hop carries session cookies across a real network.
#
# Certificates are NOT baked into the image, on purpose: a self-signed one in a
# shipped image trains users to click through browser warnings (destroying the
# point), and a real one leaks its private key into a distributable layer and
# cannot be rotated without a rebuild. Mount them instead — see the commented
# volume in docker-compose.yml.
#
# Renewals need no restart. The keypair is re-read when it changes on disk, which
# matters because a restart logs every user out (sessions are in-memory by
# design), and ACME certificates rotate every 60-90 days. A renewal that writes
# the certificate before the key keeps serving the previous one through the
# window rather than refusing handshakes.
#
# For a proxy on another host, a self-signed cert here is fine — tell the proxy
# to skip verification (cloudflared `noTLSVerify: true`, nginx
# `proxy_ssl_verify off`). For direct exposure, use a real certificate.
#TLS_CERT_FILE=/kypost/tls/fullchain.pem
#TLS_KEY_FILE=/kypost/tls/privkey.pem

# CAPTCHA on the login form, on top of the built-in 3-strikes/15-minute account
# lockout, the per-IP lockout, and the instance-wide login rate limit.
#
# DEFAULTS TO pow. Leaving CAPTCHA_PROVIDER unset now means "self-hosted
# proof-of-work", not "disabled" — the login endpoint is unauthenticated and runs
# scrypt on every attempt by design (so response timing cannot reveal whether an
# account exists), which made an ungated default an unauthenticated CPU
# amplifier. To turn it off, say so explicitly:
#
#   CAPTCHA_PROVIDER=none
#
# READ THE HTTPS NOTE UNDER pow BELOW BEFORE RELYING ON THE DEFAULT. On a plain
# http:// LAN address the check cannot run and nobody can sign in; the server
# warns about this at startup when it sees no sign of TLS in front of it.
#
#   pow       - self-hosted proof-of-work. No third-party service, no
#               callout, no user IP leaving this host, and no third-party
#               origin in the CSP. Works with no internet access. Needs no
#               site key and no secret key: the signing key is generated on
#               first use at POW_SECRET_FILE.
#
#               REQUIRES HTTPS. The browser half uses crypto.subtle, which
#               browsers expose only in a secure context, so on a plain-http://
#               deployment (anything but localhost) the check cannot run and
#               NOBODY CAN SIGN IN. The login form says so rather than failing
#               silently. Three ways to fix it: set TLS_CERT_FILE/TLS_KEY_FILE
#               above and terminate TLS here, put a TLS-terminating reverse proxy
#               (or Cloudflare Tunnel) in front, or choose another provider.
#   turnstile - Cloudflare Turnstile (needs a site key + secret key)
#   friendly  - Friendly Captcha (needs a site key + secret key)
#   none      - no CAPTCHA. The other three throttles (per-account lockout,
#               per-IP lockout, instance-wide login rate limit) still apply.
#
#CAPTCHA_PROVIDER=none
#CAPTCHA_SITE_KEY=                   # turnstile/friendly only; public, safe to expose
#CAPTCHA_SECRET_KEY=                 # turnstile/friendly only; used server-side to verify

# Proof-of-work tuning (CAPTCHA_PROVIDER=pow only).
#
# POW_MAX_NUMBER is the *base* search space, used for a client IP with no
# recent failed logins. The browser does about half of it in SHA-256 hashes:
# 5000 is imperceptible. Each recent failed login from the same address
# multiplies it by 4, up to a 1000000 ceiling, and the escalation decays after
# 15 minutes or on a successful login. So an honest first login is nearly free,
# and repeated guessing from one address gets expensive within a few attempts.
#
# Be clear about what that does and does not buy. A challenge is bound to the
# address that asked for it: the address is signed into the challenge and
# re-checked when the solution comes back, so the escalation cannot be
# laundered by fetching cheap challenges from a clean address and spending
# them from an escalated one. Escalation is still counted per address, so an
# attacker spraying from many addresses gets the base difficulty at each: this
# prices repetition, not a distributed attacker. And an attacker running native
# code is one to two orders of magnitude faster than a browser, so this deters
# casual scripted spraying, not a determined campaign. The account lockout
# remains the real brute-force defence.
#POW_MAX_NUMBER=5000
#
# POW_SECRET_FILE is where the generated HMAC signing key is persisted.
#POW_SECRET_FILE=/kypost/private/pow.key
#
# POW_SECRET overrides the generated key. Set it ONLY for a multi-replica
# deployment, where every replica must agree on one key or a challenge issued
# by one will not verify at another. A single-container install should leave
# it unset and let the key be generated. If you do set it, generate it:
#
#   openssl rand -base64 32
#
# Anything shorter than 16 characters is refused and the login CAPTCHA then
# rejects every attempt (the server still starts, and logs why). A guessable
# key is recoverable offline from one issued challenge, and whoever recovers it
# can forge a zero-work challenge that still verifies.
#POW_SECRET=

# Break-glass MFA recovery: if every admin is locked out behind two-factor
# auth with no recovery codes, set this to clear TOTP/recovery codes/push-MFA
# for ALL users on the next restart.
#
# It runs ONCE. After a successful clear the server writes a completion marker
# to STATE_DIR and every later boot is a no-op, so the variable can be left set
# without re-clearing MFA each restart. (Earlier revisions of this file claimed
# the opposite — that it never disarms — which was wrong: see
# applyMFAClearAll in backend/internal/app/app.go.)
#
# Unset it anyway once users have re-enrolled: leaving a break-glass switch on
# means a restored-from-backup STATE_DIR without the marker would clear MFA
# again.
#MFA_CLEAR_ALL=true

# PRIVACY NOTE for both relays below: a native push travels
# backend -> relay Worker -> Google (FCM) or Apple (APNs), and every hop can
# read the payload. KyPost therefore sends a GENERIC notification by default
# ("You have a new email.") with no sender, subject, or keyword; users can
# opt in to previews per account on the Notifications page. To keep
# notification content off third-party infrastructure entirely, switch the
# mobile delivery mode to "App Pull", where the device fetches queued
# notifications straight from this server.
#
# Native push relay (Android, FCM) — backend -> Cloudflare Worker -> FCM.
# The relay holds the single Firebase account the published app is built against,
# so self-hosters do not need their own Firebase credentials. See worker/README.md.
# Set PUSH_RELAY_URL and the server self-registers on first start (no operator
# involvement), persisting its key under SECRET_DIR.
# Example (using the official KyPost relay):
PUSH_RELAY_URL=https://kypost-push-relay.urlxl.workers.dev

# Advanced PUSH_RELAY overrides (leave unset unless you know you need them):
#   PUSH_RELAY_KEY      Pin a specific operator-issued key and skip auto-registration.
#                       Needed if the relay operator issues you a key, or if multiple
#                       servers share one public IP (the relay allows one key per IP).
#   PUSH_RELAY_KEY_FILE Override where the auto-registered key is persisted.
#                       Defaults to $SECRET_DIR/push_relay_key (a persistent volume).
#PUSH_RELAY_KEY=
#PUSH_RELAY_KEY_FILE=

# Native push relay (iOS, APNs) — backend -> Cloudflare Worker -> APNs.
# The relay holds the APNs auth key (.p8) for the published app's bundle ID,
# so self-hosters do not need an Apple Developer account. See worker-apns/README.md.
# Set APNS_RELAY_URL and the server self-registers on first start (no operator
# involvement), persisting its key under SECRET_DIR.
# Example (using the official KyPost relay, currently running in APNs sandbox mode):
APNS_RELAY_URL=https://kypost-push-relay-apns.urlxl.workers.dev/

# Advanced APNS_RELAY overrides (leave unset unless you know you need them):
#   APNS_RELAY_KEY      Pin a specific operator-issued key and skip auto-registration.
#   APNS_RELAY_KEY_FILE Override where the auto-registered key is persisted.
#                       Defaults to $SECRET_DIR/apns_relay_key (a persistent volume).
#APNS_RELAY_KEY=
#APNS_RELAY_KEY_FILE=
